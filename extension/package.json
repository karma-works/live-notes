{
  "name": "live-notes-extension",
  "version": "0.1.0",
  "private": true,
  "description": "Zen/Firefox-Extension: aktuelle Seite oder YouTube-Video in Live Notes speichern",
  "license": "SEE LICENSE IN ../LICENSE",
  "type": "commonjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:test": "node scripts/build.mjs --test",
    "icons": "node scripts/icons.mjs",
    "lint": "node scripts/build.mjs && web-ext lint --source-dir dist",
    "test": "node --test test/*.test.mjs",
    "test:live": "node test/live-youtube.mjs",
    "test:e2e": "node test/e2e.mjs",
    "mock": "node test/mock-server.mjs",
    "start": "node scripts/build.mjs && web-ext run --source-dir dist --firefox=/usr/bin/zen-browser",
    "sign": "bash scripts/sign.sh"
  },
  "devDependencies": {
    "@mozilla/readability": "0.6.0",
    "web-ext": "10.8.0"
  }
}
